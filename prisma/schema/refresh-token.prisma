model RefreshToken {
  id         String   @id @default(cuid()) 
  accountId  String   @unique 
  token      String   @unique 
  createdAt  DateTime @default(now()) 
  updatedAt  DateTime @default(now()) @updatedAt 
  expiresAt  DateTime

  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade) 
}