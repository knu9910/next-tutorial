model SessionLog {
  id           String   @id @default(cuid())
  accountId    String
  token        String
  ipAddress    String
  browserInfo  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  expiresAt    DateTime

  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
}